{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sam Project Diagnosis State Delta V2",
  "type": "object",
  "required": [
    "intake",
    "project_id",
    "generated_at",
    "diagnosis_mode",
    "user_role",
    "target",
    "stage",
    "capabilities",
    "evidence_added",
    "bottleneck",
    "decisions",
    "seven_day_plan",
    "permission",
    "versions"
  ],
  "properties": {
    "intake": {
      "type": "object",
      "required": ["delivery_audience", "delivery_mode", "confirmed", "tentative", "ambiguous", "conflicting", "unknown", "blocking_confirmations", "nonblocking_unknowns", "affected_sections"],
      "properties": {
        "delivery_audience": {"enum": ["self", "team", "client", "project"]},
        "delivery_mode": {"enum": ["conversation", "tentative", "internal", "client", "ledger"]},
        "confirmed": {"type": "array"},
        "tentative": {"type": "array"},
        "ambiguous": {"type": "array"},
        "conflicting": {"type": "array"},
        "unknown": {"type": "array"},
        "blocking_confirmations": {"type": "array"},
        "nonblocking_unknowns": {"type": "array"},
        "affected_sections": {"type": "array"}
      },
      "additionalProperties": false
    },
    "project_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "diagnosis_mode": {"enum": ["new", "checkup", "symptom"]},
    "user_role": {"enum": ["owner", "subject", "operator", "advisor"]},
    "target": {
      "type": "object",
      "required": ["statement", "window"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "window": {"type": "string", "minLength": 1},
        "primary_metric": {"type": ["string", "null"]},
        "guardrail_metric": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "required": ["code", "scope", "confidence"],
      "properties": {
        "code": {"enum": ["S0", "S1", "S2", "S3", "S4", "S5", "S6"]},
        "scope": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["high", "medium", "low"]}
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": ["formed", "signals", "unvalidated"],
      "properties": {
        "formed": {"type": "array", "items": {"type": "string"}},
        "signals": {"type": "array", "items": {"type": "string"}},
        "unvalidated": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "evidence_added": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "statement", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"enum": ["F", "O", "I", "H", "D", "U"]},
          "statement": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "bottleneck": {
      "type": "object",
      "required": ["module", "statement", "rationale"],
      "properties": {
        "module": {"pattern": "^(0[1-9]|1[0-7])$", "type": "string"},
        "statement": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "alternative_explanation": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "decisions": {
      "type": "object",
      "required": ["keep", "change", "defer"],
      "properties": {
        "keep": {"type": "array", "items": {"type": "string"}},
        "change": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "defer": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "seven_day_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["owner", "action", "output", "done_signal", "stop_condition"],
        "properties": {
          "owner": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "output": {"type": "string", "minLength": 1},
          "done_signal": {"type": "string", "minLength": 1},
          "stop_condition": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "experiment": {"type": ["object", "null"]},
    "next_route": {
      "type": ["object", "null"],
      "properties": {
        "function": {"type": "string"},
        "why_now": {"type": "string"},
        "required_inputs": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["function", "why_now", "required_inputs"],
      "additionalProperties": false
    },
    "permission": {
      "type": "object",
      "required": ["preview_only", "approved_write_path"],
      "properties": {
        "preview_only": {"const": true},
        "approved_write_path": {"type": "null"}
      },
      "additionalProperties": false
    },
    "versions": {
      "type": "object",
      "required": ["skill", "atom_library"],
      "properties": {
        "skill": {"const": "2.2.0-beta"},
        "atom_library": {"const": "2.0"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
