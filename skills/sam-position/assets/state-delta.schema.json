  "properties": {
    "intake": {"type": "object", "required": ["delivery_audience", "delivery_mode", "confirmed", "tentative", "ambiguous", "conflicting", "unknown", "blocking_confirmations", "nonblocking_unknowns", "affected_sections"], "properties": {"delivery_audience": {"enum": ["self", "team", "client", "project"]}, "delivery_mode": {"enum": ["conversation", "tentative", "internal", "client", "ledger"]}, "confirmed": {"type": "array"}, "tentative": {"type": "array"}, "ambiguous": {"type": "array"}, "conflicting": {"type": "array"}, "unknown": {"type": "array"}, "blocking_confirmations": {"type": "array"}, "nonblocking_unknowns": {"type": "array"}, "affected_sections": {"type": "array"}}, "additionalProperties": false},
    "source_skill": {
      "const": "sam-position"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string"
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "evidence": {
      "type": "array"
    },
    "conclusion": {
      "type": "string",
      "minLength": 1
    },
    "keep": {
      "type": "array"
    },
    "change": {
      "type": "array",
      "minItems": 1
    },
    "defer": {
      "type": "array"
    },
    "data": {
      "type": "object",
      "required": ["analysis_mode", "research_scope", "segment_basis", "audience_segments", "effective_demand", "market_value", "content_opportunities", "product_delivery_fit", "precision_warnings"],
      "properties": {
        "analysis_mode": {"enum": ["quick", "deep_single", "segment_map"]},
        "research_scope": {},
        "segment_basis": {},
        "audience_segments": {"type": "array"},
        "social_conditions": {},
        "psychological_identity_mechanisms": {},
        "language_narratives": {},
        "decision_journeys": {},
        "effective_demand": {},
        "market_value": {},
        "content_opportunities": {},
        "product_delivery_fit": {},
        "segment_relationships": {},
        "market_priority": {},
        "precision_warnings": {"type": "array"},
        "user_hypothesis": {},
        "trigger_event": {},
        "jobs": {},
        "decision_roles": {},
        "positioning_statement": {},
        "public_role": {},
        "account_promise": {},
        "exclusions": {},
        "next_experiment": {}
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1
    },
    "next_route": {
      "type": "string"
    },
    "permission": {
      "type": "object",
      "properties": {
        "preview_only": {
          "const": true
        },
        "approved_write_path": {
          "type": "null"
        }
      },
      "required": [
        "preview_only",
        "approved_write_path"
      ]
    },
    "versions": {
      "type": "object",
      "properties": {
        "skill": {
          "const": "2.3.0-beta"
        },
        "atom_library": {
