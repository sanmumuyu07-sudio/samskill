{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sam-position state delta",
  "type": "object",
  "required": [
    "intake",
    "source_skill",
    "project_id",
    "generated_at",
    "task",
    "confidence",
    "evidence",
    "conclusion",
    "keep",
    "change",
    "defer",
    "data",
    "actions",
    "next_route",
    "permission",
    "versions"
